<?xml version="1.0" encoding="utf-8"?><FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#030810">

<!-- Fundo principal -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- TOPO -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp">

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="J.A.R.V.I.S"
            android:textColor="#29B6F6"
            android:textSize="25sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <Button
            android:id="@+id/botaoConfiguracoes"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="⚙"
            android:textColor="#81D4FA"
            android:textSize="25sp"
            android:background="#071827" />

    </RelativeLayout>

    <!-- HORA -->
    <TextView
        android:id="@+id/textoRelogio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:text="14:32"
        android:textColor="#E3F2FD"
        android:textSize="43sp"
        android:textStyle="bold" />

    <!-- DATA -->
    <TextView
        android:id="@+id/textoData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="26 SET."
        android:textColor="#81D4FA"
        android:textSize="16sp" />

    <!-- CLIMA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textoClima"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☁  Sua região"
            android:textColor="#B3E5FC"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/textoPrevisao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Previsão do tempo"
            android:textColor="#64B5F6"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- REATOR ARC -->
    <FrameLayout
        android:id="@+id/painelReator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <!-- Anel externo -->
        <TextView
            android:id="@+id/anelExterno"
            android:layout_width="245dp"
            android:layout_height="245dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="◎"
            android:textColor="#0288D1"
            android:textSize="205sp" />

        <!-- Anel intermediário -->
        <TextView
            android:id="@+id/anelInterno"
            android:layout_width="205dp"
            android:layout_height="205dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="◎"
            android:textColor="#29B6F6"
            android:textSize="170sp" />

        <!-- Reator -->
        <TextView
            android:id="@+id/botaoReator"
            android:layout_width="145dp"
            android:layout_height="145dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="▽"
            android:textColor="#E1F5FE"
            android:textSize="82sp"
            android:textStyle="bold"
            android:background="#071827" />

    </FrameLayout>

    <!-- VERIFICAÇÃO -->
    <Button
        android:id="@+id/botaoVerificacao"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="4dp"
        android:text="🛡  VERIFICAR APARELHO"
        android:textColor="#B3E5FC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#071827" />

    <!-- STATUS -->
    <TextView
        android:id="@+id/textoStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:padding="5dp"
        android:text="À sua disposição."
        android:textColor="#81D4FA"
        android:textSize="14sp" />

</LinearLayout>

<!-- MENU DA ENGRENAGEM -->
<LinearLayout
    android:id="@+id/menuConfiguracoes"
    android:layout_width="245dp"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:layout_marginTop="58dp"
    android:layout_marginEnd="10dp"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#06202A"
    android:visibility="gone">

    <Button
        android:id="@+id/opcaoGerenciar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="⚙  Gerenciar JARVIS"
        android:textColor="#B3E5FC"
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:background="#092B35" />

    <Button
        android:id="@+id/opcaoPrivacidade"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="🔒  Privacidade"
        android:textColor="#B3E5FC"
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:background="#092B35" />

    <Button
        android:id="@+id/opcaoVerificacao"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="🛡  Verificação do aparelho"
        android:textColor="#B3E5FC"
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:background="#092B35" />

</LinearLayout>

</FrameLayout>

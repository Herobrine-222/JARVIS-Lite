<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050A12"
    android:padding="12dp">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="J.A.R.V.I.S"
            android:textColor="#29B6F6"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/botaoConfiguracoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Dia da semana -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="DOM. SEG. TER. QUA. QUI. SEX. SÁB."
        android:textColor="#90CAF9"
        android:textSize="12sp" />

    <!-- Relógio -->
    <TextView
        android:id="@+id/textoRelogio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="10:04"
        android:textColor="#E3F2FD"
        android:textSize="42sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textoData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="set. 26"
        android:textColor="#90CAF9"
        android:textSize="16sp" />

    <!-- Informações -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textoBateria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔋 91%"
            android:textColor="#81D4FA"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textoSom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Som: Som"
            android:textColor="#81D4FA"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Painel do telefone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textoUso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="77% usado"
            android:textColor="#4FC3F7"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textoLivre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Livre"
            android:textColor="#4FC3F7"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textoTemperatura"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="40,5°C"
            android:textColor="#4FC3F7"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Reator ARC -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/botaoReator"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="△\nARC"
            android:textColor="#29B6F6"
            android:textSize="32sp"
            android:textStyle="bold"
            android:background="#071827" />

    </FrameLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/textoStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="À sua disposição.\nSistemas online."
        android:textColor="#B3E5FC"
        android:textSize="16sp"
        android:padding="8dp" />

</LinearLayout>
